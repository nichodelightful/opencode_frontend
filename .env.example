WORKSPACE_ROOT=/data/workspaces
OPENCODE_BIN=opencode

# macOS example: /Users/YOUR_NAME/.local/share/opencode
# EC2 Ubuntu example: /home/ubuntu/.local/share/opencode
OPENCODE_AUTH_DIR=/Users/YOUR_NAME/.local/share/opencode

# Optional. Leave blank to use opencode's default model/provider.
# Example only if you want to force a model: opencode/grok-code-fast-1
OPENCODE_MODEL=
# Optional comma-separated override for the UI dropdown.
# Leave blank to use the built-in OpenCode Zen model list.
OPENCODE_MODEL_OPTIONS=
OPENCODE_TIMEOUT_MS=180000

APP_SECRET=change-me
