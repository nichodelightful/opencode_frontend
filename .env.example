WORKSPACE_ROOT=/data/workspaces
OPENCODE_BIN=opencode
OPENCODE_API_KEY=

# Optional server-side default. Go subscription models use opencode-go/<model-id>.
OPENCODE_MODEL=opencode-go/gpt-5.6-luna
# Optional comma-separated override for the UI dropdown.
# Leave blank to detect current models from the official OpenCode Go API.
OPENCODE_MODEL_OPTIONS=
OPENCODE_TIMEOUT_MS=600000

# Required login settings. Keep .env private and never commit it.
ADMIN_USERNAME=home
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48
APP_SECRET=

# Required only when starting the Cloudflare Tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
