WORKSPACE_ROOT=/data/workspaces
OPENCODE_BIN=opencode

# Directory containing auth.json. Copy secrets/opencode/auth.example.json to
# secrets/opencode/auth.json and put your real OpenCode Go API key there.
OPENCODE_AUTH_DIR=./secrets/opencode

# Optional server-side default. Go subscription models use opencode-go/<model-id>.
OPENCODE_MODEL=opencode-go/deepseek-v4-flash
# Optional comma-separated override for the UI dropdown.
# Leave blank to use the built-in OpenCode Go model list.
OPENCODE_MODEL_OPTIONS=
OPENCODE_TIMEOUT_MS=600000

# Required login settings. Generate the hash with: npm run hash-password
ADMIN_USERNAME=home
ADMIN_PASSWORD_HASH=''
# Generate with: openssl rand -base64 48
APP_SECRET=

# Required only when starting the Cloudflare Tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
