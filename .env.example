WORKSPACE_ROOT=/data/workspaces
OPENCODE_BIN=opencode
OPENCODE_PROVIDER=openai

# ChatGPT Plus/Pro OAuth is stored in the persistent opencode-auth volume.
OPENCODE_MODEL=openai/gpt-5.4
# Optional comma-separated override for the UI dropdown.
# Leave blank to detect models available to ChatGPT OAuth.
OPENCODE_MODEL_OPTIONS=
OPENCODE_TIMEOUT_MS=600000

# Optional rollback: set OPENCODE_PROVIDER=opencode-go and provide a Go key.
OPENCODE_API_KEY=

# Required login settings. Keep .env private and never commit it.
ADMIN_USERNAME=home
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48
APP_SECRET=

# Required only when starting the Cloudflare Tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
